/* pages/meditate/meditate.wxss —— 正念冥想样式 */

/* 时长选择 */
.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 50rpx;
}

.preset {
  width: 200rpx;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--sub);
  font-size: 26rpx;
}

.preset.on {
  background: var(--accent-soft);
  border-color: var(--accent-border);
  color: var(--accent);
  font-weight: 600;
}

/* 冥想舞台 */
.stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 50rpx;
}

/* 光晕 */
@keyframes halo {
  0%, 100% { transform: scale(1); opacity: 0.35; }
  50% { transform: scale(1.12); opacity: 0.6; }
}

.halo {
  position: absolute;
  top: 30rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--glow), transparent 70%);
  animation: halo 6s ease-in-out infinite;
  pointer-events: none;
}

.lotus {
  font-size: 110rpx;
  z-index: 1;
}

.time {
  font-size: 100rpx;
  font-weight: 200;
  color: var(--text);
  margin: 20rpx 0 40rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--card-hover);
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, var(--accent), var(--accent-border));
  transition: width 1s linear;
}

/* 引导语切换动画 */
@keyframes quote-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.quote {
  margin-top: 46rpx;
  font-size: 30rpx;
  color: var(--sub);
  letter-spacing: 2rpx;
  text-align: center;
  animation: quote-in 1.2s ease;
}

/* 按钮 */
.med-btn {
  text-align: center;
  padding: 28rpx 0;
  border-radius: 24rpx;
  background: var(--accent);
  color: var(--accent-text);
  font-size: 32rpx;
  font-weight: 600;
}

.med-btn.stop {
  background: var(--card);
  color: var(--text);
  border: 1rpx solid var(--accent-border);
}

.med-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  padding: 40rpx 30rpx;
}
