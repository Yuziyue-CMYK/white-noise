/* pages/pomodoro/pomodoro.wxss —— 番茄时钟样式 */

/* 方案选择 */
.plans {
  display: flex;
  gap: 18rpx;
  margin-bottom: 40rpx;
}

.plan {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--sub);
  font-size: 24rpx;
}

.plan.on {
  background: var(--accent-soft);
  border-color: var(--accent-border);
  color: var(--accent);
  font-weight: 600;
}

/* 计时盘：液态玻璃 */
.dial {
  background: var(--card);
  border: 1rpx solid var(--glass-border);
  border-radius: 44rpx;
  padding: 70rpx 50rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx var(--shadow), inset 0 2rpx 0 var(--highlight);
  backdrop-filter: blur(48rpx) saturate(1.7);
  -webkit-backdrop-filter: blur(48rpx) saturate(1.7);
}

.phase-tag {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--sub);
  letter-spacing: 4rpx;
}

.dial.work .phase-tag {
  color: var(--accent);
  border-color: var(--accent-border);
  background: var(--accent-soft);
}

.dial.rest .phase-tag {
  color: var(--danger);
  border-color: rgba(255, 157, 157, 0.4);
  background: rgba(255, 157, 157, 0.1);
}

.time {
  font-size: 130rpx;
  font-weight: 200;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  margin: 30rpx 0 40rpx;
  letter-spacing: 6rpx;
}

/* 进度条 */
.progress-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--card-hover);
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--accent), var(--accent-border));
  transition: width 1s linear;
}

.cycle-info {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: var(--sub);
}

/* 控制按钮 */
.controls {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 44rpx;
}

.ctrl {
  text-align: center;
  padding: 26rpx 0;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.ctrl.sub {
  width: 180rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--sub);
}

.ctrl.main {
  flex: 1;
  background: var(--accent);
  color: var(--accent-text);
  font-weight: 600;
}

.ctrl.main.pause {
  background: var(--card);
  color: var(--text);
  border: 1rpx solid var(--accent-border);
}

.pomo-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  padding: 40rpx 30rpx;
}
