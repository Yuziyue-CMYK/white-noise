/* pages/about/about.wxss —— 关于页样式 */

.hero {
  text-align: center;
  padding: 50rpx 0 40rpx;
}

.logo {
  font-size: 60rpx;
  font-weight: 300;
  letter-spacing: 24rpx;
  text-indent: 24rpx;
  color: var(--text);
}

.ver {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.block {
  margin-bottom: 24rpx;
}

.h {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 14rpx;
}

.p {
  font-size: 26rpx;
  color: var(--sub);
  margin-bottom: 8rpx;
}

.p.tip {
  font-size: 22rpx;
  color: var(--faint);
}

.li {
  font-size: 26rpx;
  color: var(--sub);
  line-height: 1.9;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  font-size: 24rpx;
  color: var(--sub);
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
}

.footer {
  text-align: center;
  color: var(--faint);
  font-size: 24rpx;
  padding: 30rpx 0 20rpx;
}
